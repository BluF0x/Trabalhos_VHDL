map -intstyle ise -p xc3s1200e-fg320-4 -cm area -ir off -pr off -c 100 -o top_cron_basq_map.ncd top_cron_basq.ngd top_cron_basq.pcf 
par -w -intstyle ise -ol high -t 1 top_cron_basq_map.ncd top_cron_basq.ncd top_cron_basq.pcf 
